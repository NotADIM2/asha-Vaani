# Copy this file to .env and fill in your key. .env is git-ignored - never commit it.
# Get a key at https://app.gnani.ai/voice
GNANI_API_KEY=

# Optional overrides
PORT=3000
# Challenge rules: STT must be Prisma v3.0 and TTS must be Timbre v3.0.
# STT output style: transcribe | codemix | verbatim
STT_MODEL=prisma-v3.0
STT_FORMAT=transcribe
# TTS model and voice per language (any Timbre v3.0 voice speaks all 10 languages)
TTS_MODEL=timbre-v3.0
TTS_VOICE_HI=Sunaina
TTS_VOICE_EN=Sunaina
TTS_VOICE_KN=Sunaina
# Set to 0 to disable the Evon LLM fallback extractor
LLM_ENABLED=1
LLM_MODEL=evon-v3.5
