# Copy this file to .env and fill in your key. .env is git-ignored - never commit it.
# Get a key at https://app.gnani.ai/voice
GNANI_API_KEY=

# Credit lock. Visitors (judges) open https://<app>/?code=<ACCESS_CODE> once; everyone else
# gets the free browser voice. Your own computer never needs the code. Never put it in the README.
ACCESS_CODE=
# Hard daily ceiling across all visitors (India date). Past it the app uses the browser voice.
DAILY_STT_MINUTES=45
DAILY_TTS_CHARS=30000
DAILY_LLM_CALLS=150
# Kill switch: 0 = never spend credits
GNANI_ENABLED=1

# Optional overrides
PORT=3000
# 127.0.0.1 = this computer only (default). The deploy uses 0.0.0.0.
HOST=127.0.0.1
# Challenge rules: STT must be Prisma v3.0 and TTS must be Timbre v3.0.
# STT output style: transcribe | codemix | verbatim
STT_MODEL=prisma-v3.0
STT_FORMAT=transcribe
# TTS model and voice per language (any Timbre v3.0 voice speaks all 10 languages)
TTS_MODEL=timbre-v3.0
TTS_VOICE_HI=Sunaina
TTS_VOICE_EN=Sunaina
TTS_VOICE_KN=Sunaina
# any language: TTS_VOICE_TA, TTS_VOICE_TE, TTS_VOICE_BN, TTS_VOICE_MR, TTS_VOICE_GU, TTS_VOICE_ML, TTS_VOICE_PA
# Set to 0 to disable the Evon LLM fallback extractor
LLM_ENABLED=1
LLM_MODEL=evon-v3.5
